---
import DHBar from "./DashedHorizontalBar.astro";

const pageFiles = import.meta.glob("../pages/*.{astro,md,mdx}", {
    eager: true,
});
const baseUrl = import.meta.env.BASE_URL;
const navigationItems = Object.keys(pageFiles)
    .map((filePath) => {
        const fileName = filePath.match(/\/([^/]+)\.(astro|md|mdx)$/)?.[1];

        if (!fileName) return null;

        const isHomePage = fileName === "index";

        return {
            href: isHomePage ? baseUrl : `${baseUrl}${fileName}`,
            label: isHomePage
                ? "Home"
                : fileName
                      .replace(/[-_]/g, " ")
                      .replace(/\b\w/g, (letter) => letter.toUpperCase()),
        };
    })
    .filter((item): item is { href: string; label: string } => item !== null)
    .sort((first, second) => first.href.localeCompare(second.href));
---

<header>
    <h1><a href="/">n1clude</a></h1>
    <nav>
        <ul>
            {
                navigationItems.map(({ href, label }) => (
                    <li>
                        <a href={href}>{label}</a>
                    </li>
                ))
            }
        </ul>
    </nav>
    <DHBar />
</header>

<style>
    header {
        font-family: "Cascadia Mono", monospace;
        margin-bottom: 16px;
    }

    h1 {
        margin: 8px 0;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;

        display: flex;
        flex-direction: row;
        justify-content: start;
        gap: 16px;
    }

    a {
        color: var(--text-color);
        text-decoration: none;
        padding: 2px;

        transition: color var(--button-transition-speed) linear;
        transition: background-color var(--button-transition-speed) linear;
    }

    a:hover {
        color: var(--background-color);
        background-color: var(--text-color);
    }
</style>
