---
import DHBar from "./DashedHorizontalBar.astro";

const pageFiles = {
    ...import.meta.glob("../pages/*.{astro,md,mdx}", { eager: true }),
    ...import.meta.glob("../pages/*/index.astro", { eager: true }),
};
const baseUrl = import.meta.env.BASE_URL;
const navigationItems = Object.keys(pageFiles)
    .map((filePath) => {
        const pagePath = filePath
            .replace(/^\.\.\/pages\//, "")
            .replace(/\.(astro|md|mdx)$/, "");

        if (!pagePath || pagePath === "404") return null;

        const routePath = pagePath.replace(/\/index$/, "");
        const isHomePage = routePath === "index";
        const label = isHomePage ? "Home" : routePath.split("/").at(-1);

        if (!label) return null;

        return {
            href: isHomePage ? baseUrl : `${baseUrl}${routePath}`,
            label: label
                .replace(/[-_]/g, " ")
                .replace(/\b\w/g, (letter) => letter.toUpperCase()),
        };
    })
    .filter((item): item is { href: string; label: string } => item !== null)
    .sort((first, second) => first.href.localeCompare(second.href));
---

<header>
    <h1><img src="/favicon-32x32.png" /><a href="/">n1clude</a></h1>
    <nav>
        <ul>
            {
                navigationItems.map(({ href, label }) => (
                    <li>
                        <a href={href}>{label}</a>
                    </li>
                ))
            }
        </ul>
    </nav>
    <DHBar />
</header>

<style>
    header {
        font-family: "Cascadia Mono", monospace;
        margin-bottom: 16px;
    }

    h1 {
        margin: 8px 0;
    }

    h1 img {
        height: 0.7em;
        margin-right: 4px;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;

        display: flex;
        flex-direction: row;
        justify-content: start;
        gap: 16px;
    }

    a {
        color: var(--text-color);
        text-decoration: none;
        padding: 2px;

        transition: color var(--button-transition-speed) linear;
        transition: background-color var(--button-transition-speed) linear;
    }

    a:hover {
        color: var(--background-color);
        background-color: var(--text-color);
    }
</style>
