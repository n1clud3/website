---
import { formatDate } from "../utils/datetime.ts";

interface Props {
    title: string;
    datetime: Date;
    summary: string;
    link: URL | string;
    image: URL | string;
}
const { title, datetime, summary, link, image } = Astro.props;
const dt = formatDate(datetime);
---

<a href={link} class="postcard">
    <img src={image.toString()} alt={summary} />
    <div class="meta">
        <div class="title">{title}</div>
        <div class="datetime">{dt}</div>
        <div class="summary">{summary}</div>
    </div>
</a>

<style>
    .postcard {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: start;
        gap: 16px;
        padding: 8px;
        min-height: 9rem;

        border: 1px solid var(--background-backdrop);
    }

    .postcard:hover {
        border: 1px solid var(--text-color);
        background-color: var(--background-backdrop);
        color: var(--text-color);
    }

    .meta {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
    }

    .title {
        font-size: 1.8rem;
        font-weight: bold;
    }

    .datetime {
        font-size: 0.9rem;
    }

    img {
        height: 100%;
        max-height: 9rem;
        object-fit: cover;
    }

    .summary {
        font-family: "Roboto Slab", serif;
        font-size: 0.9rem;
    }
</style>
