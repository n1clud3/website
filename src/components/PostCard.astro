---
import { formatDate } from "../utils/datetime.ts";

interface Props {
    title: string;
    datetime: Date;
    summary: string;
    link: URL | string;
    image: URL | string;
}
const { title, datetime, summary, link, image } = Astro.props;
const dt = formatDate(datetime);
---

<a href={link} class="postcard">
    <img src={image.toString()} alt="" />
    <div class="meta">
        <div class="title">{title}</div>
        <div class="datetime">{dt}</div>
        <div class="summary">{summary}</div>
    </div>
</a>

<style>
    .postcard {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: start;
        gap: 16px;
        padding: 8px;
        min-height: 9rem;

        border: 1px solid var(--background-backdrop);
    }

    .postcard:hover {
        border: 1px solid var(--text-color);
        background-color: var(--background-backdrop);
        color: var(--text-color);
    }

    .meta {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
        flex: 1 1 auto;
        /* let the text column shrink below its content width so it wraps */
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .title {
        font-size: 1.8rem;
        font-weight: bold;
    }

    img {
        flex: 0 0 auto;
        width: 12rem;
        max-width: 40%;
        height: 9rem;
        object-fit: cover;
    }

    @media (max-width: 30rem) {
        .postcard {
            flex-direction: column;
            align-items: stretch;
        }

        img {
            width: 100%;
            max-width: 100%;
        }

        .title {
            font-size: 1.4rem;
        }
    }

    .summary, .datetime {
        font-family: "Source Serif 4", serif;
        font-size: 0.9rem;
    }
</style>
